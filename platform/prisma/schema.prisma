// Standard SaaS — multi-tenant website builder for home-services businesses.
// Dev DB: SQLite. Production: switch `provider` to "postgresql" + set DATABASE_URL.
// All JSON-shaped config is stored as String (portable across SQLite/Postgres);
// typed helpers in src/lib/config.ts handle (de)serialization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── A client's account (one business = one tenant) ──────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  name         String
  subdomain    String   @unique
  customDomain String?  @unique
  domainStatus String   @default("none") // none | pending | connected
  vertical     String   @default("home-services") // which sector template
  status       String   @default("active") // active | suspended | cancelled | trial
  plan         String   @default("free") // free | starter | professional | premium
  subscriptionEndsAt DateTime? // null = no expiry (lifetime/free)
  lastRenewalReminderAt DateTime? // last time an expiry reminder was sent
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  orders       Order[]
  siteConfig   SiteConfig?
  pages        Page[]
  services     Service[]
  galleryItems GalleryItem[]
  leads        Lead[]
  appointments Appointment[]
  notices      Notice[]
  resultExams  ResultExam[]
  campaigns    Campaign[]
}

// ─── Login accounts for a tenant's admin panel ───────────────────────────────
model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  password  String // bcrypt hash
  name      String?
  role      String   @default("owner") // owner | admin | staff
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

// ─── Site-wide look & feel + header/footer (one per tenant) ───────────────────
model SiteConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme     String   @default("{}") // JSON: colors, font, radius
  header    String   @default("{}") // JSON: logo, topbar contact, nav, cta
  footer    String   @default("{}") // JSON: about, columns, social, contact
  seo       String   @default("{}") // JSON: title, description, favicon, ogImage
  customCss String   @default("") // site-wide custom CSS injected into every page
  resultConfig String @default("{}") // JSON: marksheet/report-card template settings
  adminPrefs String @default("{}") // JSON: notifyLeads, notifyAppointments, etc.
  updatedAt DateTime @updatedAt
}

// ─── Ad campaigns (marketing manager) ─────────────────────────────────────────
model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  platform  String   @default("google") // google | meta | instagram | whatsapp | local | other
  objective String   @default("leads")  // leads | traffic | awareness | sales | calls
  service   String   @default("")       // which service/product this ad promotes
  adImage   String   @default("")        // creative image for this ad
  headline  String   @default("")
  adText    String   @default("")
  targetUrl String   @default("")
  budget    Int      @default(0)  // total planned budget
  startDate String   @default("")
  endDate   String   @default("")
  // Audience targeting
  gender    String   @default("all") // all | male | female
  ageMin    Int      @default(18)
  ageMax    Int      @default(65)
  interests String   @default("[]") // JSON array of interest keywords
  locations String   @default("[]") // JSON array of target cities/areas
  radiusKm  Int      @default(0)     // target radius around locations
  status    String   @default("draft") // draft | active | paused | completed
  spend     Int      @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── Notices / circulars (managed from the admin panel) ───────────────────────
model Notice {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      String   @default("") // display date e.g. "20 Jul 2026"
  title     String
  category  String   @default("News") // Result | Admission | Exam | Event | Holiday | News
  link      String   @default("")
  attachmentUrl  String @default("") // uploaded image / PDF / document
  attachmentName String @default("") // original file name (for display)
  pinned    Boolean  @default(false)
  published Boolean  @default(true)
  order     Int      @default(0)
  demoSessionId String? // set during OTP demo sandbox — deleted when session expires
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Results: one exam dataset, uploaded via CSV ──────────────────────────────
model ResultExam {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // "Annual Examination 2026"
  published Boolean         @default(true)
  verifyDob Boolean         @default(false) // require DOB along with roll no
  createdAt DateTime        @default(now())
  results   StudentResult[]

  @@unique([tenantId, name])
}

// ─── A single student's result within an exam ─────────────────────────────────
model StudentResult {
  id         String     @id @default(cuid())
  examId     String
  exam       ResultExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  tenantId   String
  rollNo     String
  name       String
  className  String     @default("")
  section    String     @default("")
  fatherName String     @default("")
  motherName String     @default("")
  dob        String     @default("")
  subjects   String     @default("[]") // JSON: [{ name, max, obtained }]
  total      Int        @default(0)
  maxTotal   Int        @default(0)
  percentage Float      @default(0)
  grade      String     @default("")
  status     String     @default("") // Pass | Fail
  remarks    String     @default("")

  @@index([tenantId, rollNo])
}

// ─── Pages (system pages + client's custom pages) ─────────────────────────────
model Page {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String // "home", "about", "services", or a custom slug
  title     String
  isSystem  Boolean   @default(false) // system pages can't be deleted
  published Boolean   @default(true)
  order     Int       @default(0) // order in nav
  showInNav Boolean   @default(true)
  seoTitle       String @default("") // per-page SEO title override
  seoDescription String @default("") // per-page SEO meta description
  seoImage       String @default("") // per-page Open Graph share image
  noindex        Boolean @default(false) // hide this page from search engines
  sections  Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
}

// ─── Content blocks that make up a page (reorderable, toggleable) ─────────────
model Section {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    String // hero | features | serviceCategories | gallery | about | stats | cta | contactForm | quoteForm | appointmentForm | faq | richText | html
  order   Int     @default(0)
  visible Boolean @default(true)
  content String  @default("{}") // JSON blob whose shape depends on `type`
  style   String  @default("{}") // JSON: background, spacing, container width, custom class
}

// ─── Services catalogue ───────────────────────────────────────────────────────
model Service {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String // "Electrical", "Plumbing", ...
  title       String
  description String @default("")
  image       String @default("")
  order       Int    @default(0)
  slug            String @default("") // URL slug for the service detail page
  longDescription String @default("") // richer content shown on the detail page
  seoTitle        String @default("") // per-service SEO title
  seoDescription  String @default("") // per-service SEO meta description
  demoSessionId   String? // demo sandbox create — cleaned on expiry

  @@index([demoSessionId])
}

// ─── Gallery ──────────────────────────────────────────────────────────────────
model GalleryItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category String
  image    String
  caption String @default("")
  order   Int    @default(0)
  demoSessionId String?

  @@index([demoSessionId])
}

// ─── Quote / contact-form submissions ─────────────────────────────────────────
model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String   @default("")
  service   String   @default("")
  location  String   @default("")
  message   String   @default("")
  status    String   @default("new") // new | contacted | converted | closed
  demoSessionId String? // demo sandbox — deleted when session expires
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Appointment bookings ─────────────────────────────────────────────────────
model Appointment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String   @default("")
  service   String   @default("")
  date      String   @default("")
  time      String   @default("")
  message   String   @default("")
  status    String   @default("pending") // pending | confirmed | completed | cancelled
  demoSessionId String? // demo sandbox — deleted when session expires
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Marketing site: demo requests & signups for the platform itself ──────────
model PlatformLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  company   String   @default("")
  vertical  String   @default("") // sector they're interested in
  type      String   @default("demo") // demo | signup | contact
  message   String   @default("")
  status    String   @default("new")
  verified  Boolean  @default(false) // OTP verified for demo leads
  createdAt DateTime @default(now())

  demoSessions DemoSession[]
}

// ─── Isolated demo sandbox session (10 min, per vertical, per visitor) ────────
model DemoSession {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  company        String   @default("")
  vertical       String   // locked to one sector
  token          String   @unique @default(cuid())
  otpHash        String   @default("")
  otpExpiresAt   DateTime?
  verifiedAt     DateTime?
  status         String   @default("pending_otp") // pending_otp | active | expired
  expiresAt      DateTime?
  overlay        String   @default("{}") // per-session customizations (never touches tenant DB)
  pagesViewed    String   @default("[]") // JSON array of page slugs
  adminUsername  String   @default("") // temporary unique admin username (cleared on expire)
  adminPassword  String   @default("") // temporary admin password (cleared on expire)
  platformLeadId String?
  platformLead   PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phone, vertical])
  @@index([token])
  @@index([status])
  @@index([adminUsername])
}

// ─── Platform-wide settings (single row) ─────────────────────────────────────
model PlatformConfig {
  id                String   @id @default("singleton")
  razorpayKeyId     String   @default("")
  razorpayKeySecret String   @default("")
  platformName      String   @default("StandardSaaS")
  supportEmail      String   @default("")
  supportPhone      String   @default("")
  broadcastShow     Boolean  @default(false)
  broadcastText     String   @default("")
  // GST / invoicing
  gstin             String   @default("")
  businessAddress   String   @default("")
  gstRate           Int      @default(18)
  invoicePrefix     String   @default("INV")
  // No-code plan overrides (JSON: { tierId: { monthlyBase, maxServices } })
  planOverrides     String   @default("{}")
  // Renewal reminders (email)
  remindersEnabled  Boolean  @default(false)
  reminderDays      Int      @default(7)
  resendApiKey      String   @default("")
  senderEmail       String   @default("")
  // Demo gate: OTP + isolated sandbox sessions
  demoOtpMode       String   @default("screen") // screen | whatsapp
  demoDurationMinutes Int    @default(10)
  demoWhatsAppToken String   @default("")
  demoWhatsAppPhoneId String @default("")
  // AI Website Builder (Groq — server-side only)
  groqApiKey        String   @default("")
  groqModel         String   @default("") // blank = openai/gpt-oss-120b
  updatedAt         DateTime @updatedAt
}

// ─── Discount coupons for the marketing checkout ──────────────────────────────
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int       @default(0) // 0-100
  active     Boolean   @default(true)
  maxUses    Int       @default(0) // 0 = unlimited
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ─── AI website builder (Groq planning → existing section engine) ─────────────
model AiGeneration {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String   // plan | generate | modify | apply
  prompt     String
  blueprint  String   @default("{}") // structured plan JSON
  operations String   @default("[]") // modify ops JSON
  snapshot   String   @default("{}") // pre-modify snapshot for rollback
  status     String   @default("completed") // pending | completed | failed
  error      String   @default("")
  pageId     String   @default("") // optional page scope
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ─── Super-admin (platform owner) accounts ────────────────────────────────────
model PlatformUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash
  name      String?
  createdAt DateTime @default(now())
}

// ─── Subscription orders / payments ───────────────────────────────────────────
model Order {
  id              String   @id @default(cuid())
  customerName    String
  email           String
  phone           String   @default("")
  company         String   @default("")
  vertical        String
  subdomain       String
  plan            String // 1m | 3m | 6m | 1y | 2y | lifetime
  amount          Int // in paise (INR)
  currency        String   @default("INR")
  status          String   @default("created") // created | paid | failed | provisioned | refunded
  gateway         String   @default("mock") // mock | razorpay | manual-*
  gatewayOrderId  String   @default("")
  gatewayPayId    String   @default("")
  invoiceNo       String?  @unique // assigned once paid/provisioned
  refundReason    String   @default("")
  refundedAt      DateTime?
  passwordHash    String   @default("") // bcrypt of the admin password chosen at checkout (for provisioning/recovery)
  provisionError  String   @default("") // last provisioning error, for diagnostics/retry
  couponCode      String   @default("") // applied only after payment succeeds
  aiBlueprint     String   @default("{}") // JSON plan from marketing AI builder
  design          String   @default("") // design preset id (lib/designs.ts); "" = template as designed
  kind            String   @default("new") // new | renew | upgrade
  tenantId        String? // set after provisioning (or for renewals, set at create)
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
