// SitePixl — multi-tenant website builder for home-services businesses.
// Database: MySQL 8 (DATABASE_URL=mysql://user:pass@host:3306/db).
// Non-key strings are MEDIUMTEXT; keys stay VARCHAR(191) so they can be indexed.
// All JSON-shaped config is stored as String (portable across SQLite/Postgres);
// typed helpers in src/lib/config.ts handle (de)serialization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── A client's account (one business = one tenant) ──────────────────────────
model Tenant {
  id                    String    @id @default(cuid())
  name                  String    @db.MediumText
  subdomain             String    @unique
  customDomain          String?   @unique
  domainStatus          String    @default("none") @db.MediumText // none | pending | connected
  vertical              String    @default("home-services") @db.MediumText // which sector template
  status                String    @default("active") @db.MediumText // active | suspended | cancelled | trial
  plan                  String    @default("free") @db.MediumText // free | starter | professional | premium
  subscriptionEndsAt    DateTime? // null = no expiry (lifetime/free)
  lastRenewalReminderAt DateTime? // last time an expiry reminder was sent
  cancelledAt           DateTime?
  cancelReason          String?   @db.MediumText
  referralCode          String?   @unique // lazily created, shared as ?ref=CODE
  referredByTenantId    String? // tenant whose referral brought this customer (permanent)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users        User[]
  orders       Order[]
  siteConfig   SiteConfig?
  pages        Page[]
  services     Service[]
  galleryItems GalleryItem[]
  leads        Lead[]
  appointments Appointment[]
  notices      Notice[]
  resultExams  ResultExam[]
  campaigns    Campaign[]
  people       Person[]
  events       SiteEvent[]
  properties   Property[]
  causes       Cause[]
  volunteers   Volunteer[]
  donations    SiteDonation[]
  mediaFiles   MediaFile[]
  referralCommissions ReferralCommission[]
  referralWithdrawals ReferralWithdrawal[]
  pageViews    PageView[]
  products     Product[]
  storeOrders  StoreOrder[]
  collections  Collection[]
  storeCoupons StoreCoupon[]
  storeCustomers StoreCustomer[]
  abandonedCarts AbandonedCart[]
  quoteRequests QuoteRequest[]
}

// ─── Login accounts for a tenant's admin panel ───────────────────────────────
model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  password  String   @db.MediumText // bcrypt hash
  name      String?  @db.MediumText
  role      String   @default("owner") @db.MediumText // owner | admin | staff
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

// ─── Site-wide look & feel + header/footer (one per tenant) ───────────────────
model SiteConfig {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme        String   @default("{}") @db.MediumText // JSON: colors, font, radius
  header       String   @default("{}") @db.MediumText // JSON: logo, topbar contact, nav, cta
  footer       String   @default("{}") @db.MediumText // JSON: about, columns, social, contact
  seo          String   @default("{}") @db.MediumText // JSON: title, description, favicon, ogImage
  customCss    String   @default("") @db.MediumText // site-wide custom CSS injected into every page
  resultConfig String   @default("{}") @db.MediumText // JSON: marksheet/report-card template settings
  adminPrefs   String   @default("{}") @db.MediumText // JSON: notifyLeads, notifyAppointments, etc.
  payments     String   @default("{}") @db.MediumText // JSON: tenant Razorpay / UPI / bank / QR
  integrations String   @default("{}") @db.MediumText // JSON: third-party integrations (chat, analytics, pay links…)
  store        String   @default("{}") @db.MediumText // JSON: online-store settings (shipping, COD, UPI, WhatsApp) — lib/store.ts
  updatedAt    DateTime @updatedAt
}

// ─── Ad campaigns (marketing manager) ─────────────────────────────────────────
model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.MediumText
  platform  String   @default("google") @db.MediumText // google | meta | instagram | whatsapp | local | other
  objective String   @default("leads") @db.MediumText // leads | traffic | awareness | sales | calls
  service   String   @default("") @db.MediumText // which service/product this ad promotes
  adImage   String   @default("") @db.MediumText // creative image for this ad
  headline  String   @default("") @db.MediumText
  adText    String   @default("") @db.MediumText
  targetUrl String   @default("") @db.MediumText
  budget    Int      @default(0) // total planned budget
  startDate String   @default("") @db.MediumText
  endDate   String   @default("") @db.MediumText
  // Audience targeting
  gender    String   @default("all") @db.MediumText // all | male | female
  ageMin    Int      @default(18)
  ageMax    Int      @default(65)
  interests String   @default("[]") @db.MediumText // JSON array of interest keywords
  locations String   @default("[]") @db.MediumText // JSON array of target cities/areas
  radiusKm  Int      @default(0) // target radius around locations
  status    String   @default("draft") @db.MediumText // draft | active | paused | completed
  spend     Int      @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)
  demoSessionId String? // demo sandbox — deleted when session expires
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Notices / circulars (managed from the admin panel) ───────────────────────
model Notice {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date           String   @default("") @db.MediumText // display date e.g. "20 Jul 2026"
  title          String   @db.MediumText
  category       String   @default("News") @db.MediumText // Result | Admission | Exam | Event | Holiday | News
  link           String   @default("") @db.MediumText
  attachmentUrl  String   @default("") @db.MediumText // uploaded image / PDF / document
  attachmentName String   @default("") @db.MediumText // original file name (for display)
  pinned         Boolean  @default(false)
  published      Boolean  @default(true)
  order          Int      @default(0)
  demoSessionId  String? // set during OTP demo sandbox — deleted when session expires
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Results: one exam dataset, uploaded via CSV ──────────────────────────────
model ResultExam {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // "Annual Examination 2026"
  published Boolean         @default(true)
  verifyDob Boolean         @default(false) // require DOB along with roll no
  createdAt DateTime        @default(now())
  results   StudentResult[]

  @@unique([tenantId, name])
}

// ─── A single student's result within an exam ─────────────────────────────────
model StudentResult {
  id         String     @id @default(cuid())
  examId     String
  exam       ResultExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  tenantId   String
  rollNo     String
  name       String     @db.MediumText
  className  String     @default("") @db.MediumText
  section    String     @default("") @db.MediumText
  fatherName String     @default("") @db.MediumText
  motherName String     @default("") @db.MediumText
  dob        String     @default("") @db.MediumText
  subjects   String     @default("[]") @db.MediumText // JSON: [{ name, max, obtained }]
  total      Int        @default(0)
  maxTotal   Int        @default(0)
  percentage Float      @default(0)
  grade      String     @default("") @db.MediumText
  status     String     @default("") @db.MediumText // Pass | Fail
  remarks    String     @default("") @db.MediumText

  @@index([tenantId, rollNo])
}

// ─── Pages (system pages + client's custom pages) ─────────────────────────────
model Page {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug           String // "home", "about", "services", or a custom slug
  title          String    @db.MediumText
  isSystem       Boolean   @default(false) // system pages can't be deleted
  published      Boolean   @default(true)
  order          Int       @default(0) // order in nav
  showInNav      Boolean   @default(true)
  seoTitle       String    @default("") @db.MediumText // per-page SEO title override
  seoDescription String    @default("") @db.MediumText // per-page SEO meta description
  seoImage       String    @default("") @db.MediumText // per-page Open Graph share image
  noindex        Boolean   @default(false) // hide this page from search engines
  focusKeyword   String    @default("") @db.MediumText // SEO cockpit: the phrase this page should rank for
  sections       Section[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, slug])
}

// ─── Content blocks that make up a page (reorderable, toggleable) ─────────────
model Section {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    String  @db.MediumText // hero | features | serviceCategories | gallery | about | stats | cta | contactForm | quoteForm | appointmentForm | faq | richText | html
  order   Int     @default(0)
  visible Boolean @default(true)
  content String  @default("{}") @db.MediumText // JSON blob whose shape depends on `type`
  style   String  @default("{}") @db.MediumText // JSON: background, spacing, container width, custom class
}

// ─── Services catalogue ───────────────────────────────────────────────────────
model Service {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        String  @db.MediumText // "Electrical", "Plumbing", ...
  title           String  @db.MediumText
  description     String  @default("") @db.MediumText
  image           String  @default("") @db.MediumText
  order           Int     @default(0)
  slug            String  @default("") @db.MediumText // URL slug for the service detail page
  longDescription String  @default("") @db.MediumText // richer content shown on the detail page
  seoTitle        String  @default("") @db.MediumText // per-service SEO title
  seoDescription  String  @default("") @db.MediumText // per-service SEO meta description
  demoSessionId   String? // demo sandbox create — cleaned on expiry

  @@index([demoSessionId])
}

// ─── Gallery ──────────────────────────────────────────────────────────────────
model GalleryItem {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      String  @db.MediumText
  image         String  @db.MediumText
  caption       String  @default("") @db.MediumText
  order         Int     @default(0)
  demoSessionId String?

  @@index([demoSessionId])
}

// ─── Public website people (trustees, doctors, faculty — not admin logins) ───
model Person {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String  @db.MediumText
  role          String  @default("") @db.MediumText
  bio           String  @default("") @db.MediumText
  image         String  @default("") @db.MediumText
  groupName     String  @default("core") @db.MediumText // leadership | core
  experience    String  @default("") @db.MediumText
  linkedin      String  @default("") @db.MediumText
  instagram     String  @default("") @db.MediumText
  order         Int     @default(0)
  published     Boolean @default(true)
  demoSessionId String?

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── NGO fundraising causes (goal, live raised total, impact tiers) ──────────
model Cause {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug          String   @default("")
  title         String   @db.MediumText
  category      String   @default("") @db.MediumText // e.g. Education, Health, Relief
  summary       String   @default("") @db.MediumText // one line for cards
  story         String   @default("") @db.MediumText // long text (paragraphs separated by blank lines)
  coverImage    String   @default("") @db.MediumText
  gallery       String   @default("[]") @db.MediumText // JSON string[]
  goalAmount    Int      @default(0) // INR; 0 = open-ended
  offlineRaised Int      @default(0) // INR raised outside the site (cheques, events); online paid donations are added on top
  offlineDonors Int      @default(0)
  deadline      String   @default("") @db.MediumText // YYYY-MM-DD; "" = ongoing
  urgent        Boolean  @default(false)
  beneficiaries String   @default("") @db.MediumText // "1,200 children in 14 villages"
  location      String   @default("") @db.MediumText
  impactTiers   String   @default("[]") @db.MediumText // JSON { amount: number, label: string }[] — "₹500 feeds 20 children"
  updates       String   @default("[]") @db.MediumText // JSON { date: string, title: string, text: string }[]
  status        String   @default("active") @db.MediumText // active | completed | paused
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  order         Int      @default(0)
  demoSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Real-estate listings (broker / PG / builder sites) ───────────────────────
model Property {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug          String  @default("")
  title         String  @db.MediumText
  purpose       String  @default("sale") @db.MediumText // sale | rent | pg | project
  propertyType  String  @default("apartment") @db.MediumText // apartment | villa | house | plot | commercial | office | shop | pg-room | hostel
  price         Int     @default(0) // INR; 0 = "price on request"
  priceNote     String  @default("") @db.MediumText // e.g. "onwards", "per month", "per bed"
  deposit       Int     @default(0) // INR (rent / PG)
  maintenance   Int     @default(0) // INR per month
  bhk           String  @default("") @db.MediumText // "2 BHK", "1 RK", "Single sharing"…
  areaSqft      Int     @default(0)
  furnishing    String  @default("") @db.MediumText // furnished | semi-furnished | unfurnished
  bathrooms     Int     @default(0)
  floor         String  @default("") @db.MediumText // "5 of 12"
  facing        String  @default("") @db.MediumText
  parking       String  @default("") @db.MediumText
  availableFrom String  @default("") @db.MediumText // "Immediate" | YYYY-MM-DD
  possession    String  @default("") @db.MediumText // builder projects: "Dec 2027" / "Ready to move"
  rera          String  @default("") @db.MediumText // RERA registration no.
  sharing       String  @default("") @db.MediumText // PG: single / double / triple (comma list)
  foodIncluded  Boolean @default(false) // PG meals
  gender        String  @default("") @db.MediumText // PG: boys | girls | co-living
  locality      String  @default("") @db.MediumText
  city          String  @default("") @db.MediumText
  address       String  @default("") @db.MediumText
  mapUrl        String  @default("") @db.MediumText
  summary       String  @default("") @db.MediumText // one line for cards
  description   String  @default("") @db.MediumText
  highlights    String  @default("[]") @db.MediumText // JSON string[]
  amenities     String  @default("[]") @db.MediumText // JSON string[] (ids from lib/property AMENITIES)
  coverImage    String  @default("") @db.MediumText
  gallery       String  @default("[]") @db.MediumText // JSON string[]
  floorPlans    String  @default("[]") @db.MediumText // JSON { label, image, area? }[]
  brochureUrl   String  @default("") @db.MediumText
  videoUrl      String  @default("") @db.MediumText
  status        String  @default("available") @db.MediumText // available | under-offer | sold | rented
  featured      Boolean @default(false)
  published     Boolean @default(true)
  order         Int     @default(0)
  demoSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Public events / programs (list + detail pages) ──────────────────────────
model SiteEvent {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug               String  @default("")
  title              String  @db.MediumText
  activityName       String  @default("") @db.MediumText
  shortDescription   String  @default("") @db.MediumText
  programDescription String  @default("") @db.MediumText
  date               String  @default("") @db.MediumText // ISO date YYYY-MM-DD
  location           String  @default("") @db.MediumText
  organizedBy        String  @default("") @db.MediumText
  dignitaries        String  @default("") @db.MediumText
  impact             String  @default("") @db.MediumText
  coverImage         String  @default("") @db.MediumText
  gallery            String  @default("[]") @db.MediumText // JSON string[]
  objectives         String  @default("[]") @db.MediumText // JSON string[]
  documents          String  @default("[]") @db.MediumText // JSON { label, url }[]
  status             String  @default("auto") @db.MediumText // auto | upcoming | completed
  mapUrl             String  @default("") @db.MediumText
  venueNote          String  @default("") @db.MediumText
  blocks             String  @default("[]") @db.MediumText // JSON custom story blocks
  enableDonate       Boolean @default(false)
  donateAmount       Int     @default(0) // suggested INR
  donateLabel        String  @default("") @db.MediumText
  showQr             Boolean @default(false)
  qrImage            String  @default("") @db.MediumText
  qrCaption          String  @default("") @db.MediumText
  published          Boolean @default(true)
  order              Int     @default(0)
  demoSessionId      String?

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([demoSessionId])
}

// Public donations collected on a tenant site (event or donate page)
model SiteDonation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId        String   @default("") @db.MediumText
  causeId        String   @default("") @db.MediumText // Cause.id when given to a fundraising cause
  name           String   @default("") @db.MediumText
  email          String   @default("") @db.MediumText
  phone          String   @default("") @db.MediumText
  amount         Int      @default(0) // paise
  status         String   @default("created") @db.MediumText // created | paid | failed
  gateway        String   @default("upi") @db.MediumText // razorpay | upi | mock
  gatewayOrderId String   @default("") @db.MediumText
  gatewayPayId   String   @default("") @db.MediumText
  note           String   @default("") @db.MediumText
  demoSessionId  String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Volunteer applications from the public form ─────────────────────────────
model Volunteer {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String   @db.MediumText
  phone         String   @db.MediumText
  email         String   @default("") @db.MediumText
  age           String   @default("") @db.MediumText
  gender        String   @default("") @db.MediumText
  city          String   @default("") @db.MediumText
  state         String   @default("") @db.MediumText
  interest      String   @default("") @db.MediumText
  availability  String   @default("") @db.MediumText
  mode          String   @default("") @db.MediumText
  experience    String   @default("") @db.MediumText
  status        String   @default("new") @db.MediumText // new | contacted | accepted | declined
  demoSessionId String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Quote / contact-form submissions ─────────────────────────────────────────
model Lead {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String   @db.MediumText
  phone         String   @db.MediumText
  email         String   @default("") @db.MediumText
  service       String   @default("") @db.MediumText
  location      String   @default("") @db.MediumText
  message       String   @default("") @db.MediumText
  status        String   @default("new") @db.MediumText // new | contacted | converted | closed
  demoSessionId String? // demo sandbox — deleted when session expires
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Appointment bookings ─────────────────────────────────────────────────────
model Appointment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String   @db.MediumText
  phone         String   @db.MediumText
  email         String   @default("") @db.MediumText
  service       String   @default("") @db.MediumText
  date          String   @default("") @db.MediumText
  time          String   @default("") @db.MediumText
  message       String   @default("") @db.MediumText
  status        String   @default("pending") @db.MediumText // pending | confirmed | completed | cancelled
  demoSessionId String? // demo sandbox — deleted when session expires
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([demoSessionId])
}

// ─── Marketing site: demo requests & signups for the platform itself ──────────
model PlatformLead {
  id        String   @id @default(cuid())
  name      String   @db.MediumText
  email     String   @db.MediumText
  phone     String   @default("") @db.MediumText
  company   String   @default("") @db.MediumText
  vertical  String   @default("") @db.MediumText // sector they're interested in
  type      String   @default("demo") @db.MediumText // demo | signup | contact
  message   String   @default("") @db.MediumText
  status    String   @default("new") @db.MediumText
  verified  Boolean  @default(false) // OTP verified for demo leads
  createdAt DateTime @default(now())

  demoSessions DemoSession[]
}

// ─── Isolated demo sandbox session (10 min, per vertical, per visitor) ────────
model DemoSession {
  id             String        @id @default(cuid())
  name           String        @db.MediumText
  email          String        @db.MediumText
  phone          String
  company        String        @default("") @db.MediumText
  vertical       String // locked to one sector
  token          String        @unique @default(cuid())
  otpHash        String        @default("") @db.MediumText
  otpExpiresAt   DateTime?
  verifiedAt     DateTime?
  status         String        @default("pending_otp") // pending_otp | active | expired
  expiresAt      DateTime?
  overlay        String        @default("{}") @db.MediumText // per-session customizations (never touches tenant DB)
  pagesViewed    String        @default("[]") @db.MediumText // JSON array of page slugs
  adminUsername  String        @default("") // temporary unique admin username (cleared on expire)
  adminPassword  String        @default("") @db.MediumText // temporary admin password (cleared on expire)
  platformLeadId String?
  platformLead   PlatformLead? @relation(fields: [platformLeadId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([phone, vertical])
  @@index([token])
  @@index([status])
  @@index([adminUsername])
}

// ─── Platform-wide settings (single row) ─────────────────────────────────────
model PlatformConfig {
  id                  String   @id @default("singleton")
  razorpayKeyId       String   @default("") @db.MediumText
  razorpayKeySecret   String   @default("") @db.MediumText
  platformName        String   @default("SitePixl") @db.MediumText
  supportEmail        String   @default("") @db.MediumText
  supportPhone        String   @default("") @db.MediumText
  broadcastShow       Boolean  @default(false)
  broadcastText       String   @default("") @db.MediumText
  // GST / invoicing
  gstin               String   @default("") @db.MediumText
  businessAddress     String   @default("") @db.MediumText
  gstRate             Int      @default(18)
  invoicePrefix       String   @default("INV") @db.MediumText
  // No-code plan overrides (JSON: { tierId: { monthlyBase, limits: {...} } }; legacy maxServices ok)
  planOverrides       String   @default("{}") @db.MediumText
  // Renewal reminders (email)
  remindersEnabled    Boolean  @default(false)
  reminderDays        Int      @default(7)
  resendApiKey        String   @default("") @db.MediumText
  senderEmail         String   @default("") @db.MediumText
  // Demo gate: OTP + isolated sandbox sessions
  demoOtpMode         String   @default("screen") @db.MediumText // screen | whatsapp
  demoDurationMinutes Int      @default(10)
  demoWhatsAppToken   String   @default("") @db.MediumText
  demoWhatsAppPhoneId String   @default("") @db.MediumText
  // AI Website Builder (Groq — server-side only)
  groqApiKey          String   @default("") @db.MediumText
  groqModel           String   @default("") @db.MediumText // blank = openai/gpt-oss-120b
  // Multi-provider AI (lib/ai/providers.ts). groqApiKey/groqModel stay as the Groq fallback.
  aiProvider          String   @default("groq") @db.MediumText // groq | openai | gemini | openrouter | deepseek | custom
  aiKeys              String   @default("{}") @db.MediumText // JSON { provider: apiKey }
  aiModels            String   @default("{}") @db.MediumText // JSON { provider: model }
  aiBaseUrl           String   @default("") @db.MediumText // custom provider endpoint (OpenAI-compatible)
  // Referral program settings (JSON, see lib/referral.ts resolveReferralSettings)
  referralSettings    String   @default("{}") @db.MediumText
  updatedAt           DateTime @updatedAt
}

// ─── Discount coupons for the marketing checkout ──────────────────────────────
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int       @default(0) // 0-100
  active     Boolean   @default(true)
  maxUses    Int       @default(0) // 0 = unlimited
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ─── AI website builder (Groq planning → existing section engine) ─────────────
model AiGeneration {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String   @db.MediumText // plan | generate | modify | apply
  prompt     String   @db.MediumText
  blueprint  String   @default("{}") @db.MediumText // structured plan JSON
  operations String   @default("[]") @db.MediumText // modify ops JSON
  snapshot   String   @default("{}") @db.MediumText // pre-modify snapshot for rollback
  status     String   @default("completed") @db.MediumText // pending | completed | failed
  error      String   @default("") @db.MediumText
  pageId     String   @default("") @db.MediumText // optional page scope
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ─── Uploaded files (storage accounting: usage = SUM(bytes) per tenant) ───────
model MediaFile {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url          String   @unique @db.VarChar(512)
  bytes        Int
  mime         String   @db.MediumText
  originalName String   @default("") @db.MediumText
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// ─── Super-admin (platform owner) accounts ────────────────────────────────────
model PlatformUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   @db.MediumText // bcrypt hash
  name      String?  @db.MediumText
  createdAt DateTime @default(now())
}

// ─── Subscription orders / payments ───────────────────────────────────────────
model Order {
  id             String    @id @default(cuid())
  customerName   String    @db.MediumText
  email          String    @db.MediumText
  phone          String    @default("") @db.MediumText
  company        String    @default("") @db.MediumText
  vertical       String    @db.MediumText
  subdomain      String    @db.MediumText
  plan           String    @db.MediumText // 1m | 3m | 6m | 1y | 2y | lifetime
  amount         Int // in paise (INR)
  currency       String    @default("INR") @db.MediumText
  status         String    @default("created") @db.MediumText // created | paid | failed | provisioned | refunded
  gateway        String    @default("mock") @db.MediumText // mock | razorpay | manual-*
  gatewayOrderId String    @default("") @db.MediumText
  gatewayPayId   String    @default("") @db.MediumText
  invoiceNo      String?   @unique // assigned once paid/provisioned
  refundReason   String    @default("") @db.MediumText
  refundedAt     DateTime?
  passwordHash   String    @default("") @db.MediumText // bcrypt of the admin password chosen at checkout (for provisioning/recovery)
  provisionError String    @default("") @db.MediumText // last provisioning error, for diagnostics/retry
  couponCode     String    @default("") @db.MediumText // applied only after payment succeeds
  aiBlueprint    String    @default("{}") @db.MediumText // JSON plan from marketing AI builder
  design         String    @default("") @db.MediumText // design preset id (lib/designs.ts); "" = template as designed
  kind           String    @default("new") @db.MediumText // new | renew | upgrade
  referrerTenantId String? // tenant credited for this sale (referral program)
  tenantId       String? // set after provisioning (or for renewals, set at create)
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Referral program (lib/referral.ts = money math, lib/referralServer.ts = DB) ─
// One commission per qualifying paid order (orderId unique = idempotent).
model ReferralCommission {
  id               String    @id @default(cuid())
  referrerTenantId String
  referrer         Tenant    @relation(fields: [referrerTenantId], references: [id], onDelete: Cascade)
  orderId          String    @unique
  referredTenantId String?
  referredName     String    @default("") @db.MediumText
  baseAmount       Int // order amount before GST, paise
  ratePct          Int
  amount           Int // commission, paise
  status           String    @default("earned") @db.MediumText // earned | requested | paid | reversed (pending/available derived from availableAt)
  availableAt      DateTime // end of the hold period
  withdrawalId     String?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([referrerTenantId])
  @@index([withdrawalId])
}

model ReferralWithdrawal {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Int // gross, paise
  tdsPct        Int       @default(0)
  tdsAmount     Int       @default(0)
  netAmount     Int
  method        String    @db.MediumText // upi | bank
  upiId         String    @default("") @db.MediumText
  accountName   String    @default("") @db.MediumText
  accountNumber String    @default("") @db.MediumText
  ifsc          String    @default("") @db.MediumText
  pan           String    @default("") @db.MediumText
  status        String    @default("requested") @db.MediumText // requested | paid | rejected
  reference     String    @default("") @db.MediumText // UTR when paid
  rejectReason  String    @default("") @db.MediumText
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
}

// ─── First-party visitor analytics: one aggregate row per tenant/day/path ─────
// No IPs, cookies or user agents stored. Purged after 13 months (lib/retention.ts).
model PageView {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day      String @db.VarChar(10) // "YYYY-MM-DD" (IST)
  path     String @db.VarChar(191)
  views    Int    @default(0)

  @@unique([tenantId, day, path])
}

// ─── Online store (e-commerce sectors, lib/store.ts) ──────────────────────────
model Product {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug          String   @default("")
  name          String   @db.MediumText
  category      String   @default("") @db.MediumText
  price         Int      @default(0) // INR (whole rupees)
  mrp           Int      @default(0) // INR "compare at" price; 0 = no strike-through
  images        String   @default("[]") @db.MediumText // JSON string[]
  description   String   @default("") @db.MediumText
  stock         Int      @default(0)
  options       String   @default("[]") @db.MediumText // JSON { name, values[] }[] e.g. Size / Colour
  badge         String   @default("") @db.MediumText // "Bestseller", "New"…
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  order         Int      @default(0)
  sku           String   @default("") @db.MediumText
  weightGrams   Int      @default(0) // used for shipping rates / courier booking
  hsn           String   @default("") @db.MediumText // GST HSN code (invoice)
  gstRate       Int      @default(0) // GST % included in price (0, 5, 12, 18, 28)
  tags          String   @default("[]") @db.MediumText // JSON string[]
  trackStock    Boolean  @default(true)
  allowBackorder Boolean @default(false) // sell when stock is 0
  seoTitle      String   @default("") @db.MediumText
  seoDescription String  @default("") @db.MediumText
  // B2B catalogue / enquiry mode
  specs         String   @default("[]") @db.MediumText // JSON { label, value }[] — material, dimensions, thickness, finish…
  moq           Int      @default(0) // minimum order quantity; 0 = none
  unit          String   @default("") @db.MediumText // "piece", "set", "metre"
  customizable  Boolean  @default(false)
  catalogueUrl  String   @default("") @db.MediumText // product PDF catalogue / spec sheet
  variants      ProductVariant[]
  reviews       ProductReview[]
  demoSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([demoSessionId])
}

model StoreOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo       Int
  customerName  String   @db.MediumText
  phone         String   @db.MediumText
  email         String   @default("") @db.MediumText
  address       String   @default("") @db.MediumText
  city          String   @default("") @db.MediumText
  pincode       String   @default("") @db.MediumText
  items         String   @default("[]") @db.MediumText // JSON snapshot { productId, name, price, qty, options, image }[]
  subtotal      Int      @default(0) // INR
  shipping      Int      @default(0)
  discount      Int      @default(0)
  total         Int      @default(0)
  paymentMethod String   @default("cod") @db.MediumText // cod | upi | whatsapp | online
  paymentStatus String   @default("pending") @db.MediumText // pending | paid | refunded
  status        String   @default("new") @db.MediumText // new | confirmed | packed | shipped | delivered | cancelled
  note          String   @default("") @db.MediumText
  // Shopify-style extras
  customerId    String? // StoreCustomer when signed in / matched by email
  state         String   @default("") @db.MediumText
  addressLine2  String   @default("") @db.MediumText // landmark / area
  tax           Int      @default(0) // GST included in total (for invoice)
  codFee        Int      @default(0)
  couponCode    String   @default("") @db.MediumText
  paymentRef    String   @default("") @db.MediumText // gateway order id (e.g. Razorpay order_...)
  paymentId     String   @default("") @db.MediumText // gateway payment id
  refundAmount  Int      @default(0)
  shippingProvider String @default("manual") @db.MediumText // manual | shiprocket | delhivery
  courier       String   @default("") @db.MediumText // courier name shown to customer
  awb           String   @default("") @db.MediumText // tracking / AWB number
  trackingUrl   String   @default("") @db.MediumText
  shipmentRef   String   @default("") @db.MediumText // partner shipment / order id
  weightGrams   Int      @default(0)
  timeline      String   @default("[]") @db.MediumText // JSON { at, status, note }[]
  cancelReason  String   @default("") @db.MediumText
  returnStatus  String   @default("none") @db.MediumText // none | requested | approved | rejected | received | refunded
  returnReason  String   @default("") @db.MediumText
  invoiceNo     String   @default("") @db.MediumText
  trackToken    String   @default("") @db.VarChar(64) // secret for the public /track page link
  deliveredAt   DateTime?
  demoSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, orderNo])
  @@index([customerId])
  @@index([trackToken])
  @@index([tenantId])
  @@index([demoSessionId])
}

// Per-combination stock/price for products with options (Size x Colour). Products without options have none.
// Multi-product bulk quote / custom project enquiries (B2B enquiry-mode stores).
model QuoteRequest {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refNo         Int // shown as e.g. Q-1001, unique per store
  kind          String   @default("bulk") @db.MediumText // bulk | project
  name          String   @db.MediumText
  company       String   @default("") @db.MediumText
  phone         String   @db.MediumText
  whatsapp      String   @default("") @db.MediumText
  email         String   @default("") @db.MediumText
  gstin         String   @default("") @db.MediumText
  city          String   @default("") @db.MediumText
  state         String   @default("") @db.MediumText
  items         String   @default("[]") @db.MediumText // JSON { productId, name, sku, qty, note }[]
  expectedDate  String   @default("") @db.MediumText
  projectType   String   @default("") @db.MediumText // hotel, restaurant, hospital…
  location      String   @default("") @db.MediumText
  estQuantity   String   @default("") @db.MediumText
  details       String   @default("") @db.MediumText // project details / description
  customSpecs   String   @default("") @db.MediumText
  attachments   String   @default("[]") @db.MediumText // JSON { url, name, size }[] — drawings, BOQ, images, PDFs
  status        String   @default("new") @db.MediumText // new | contacted | quoted | won | lost
  quoteAmount   Int      @default(0)
  adminNote     String   @default("") @db.MediumText
  demoSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, refNo])
  @@index([tenantId])
  @@index([demoSessionId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId  String
  title     String  @db.MediumText // "M / Red"
  options   String  @default("{}") @db.MediumText // JSON { [optionName]: value }
  sku       String  @default("") @db.MediumText
  price     Int     @default(0) // 0 = use product price
  mrp       Int     @default(0)
  stock     Int     @default(0)
  image     String  @default("") @db.MediumText
  order     Int     @default(0)

  @@index([productId])
  @@index([tenantId])
}

// Manual product groups ("Summer sale", "Under 999") shown at /collections/<slug>.
model Collection {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug          String   @default("")
  title         String   @db.MediumText
  description   String   @default("") @db.MediumText
  image         String   @default("") @db.MediumText
  productIds    String   @default("[]") @db.MediumText // JSON string[] in display order
  published     Boolean  @default(true)
  order         Int      @default(0)
  demoSessionId String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([demoSessionId])
}

model ProductReview {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   @db.MediumText
  rating        Int      @default(5) // 1-5
  title         String   @default("") @db.MediumText
  body          String   @default("") @db.MediumText
  status        String   @default("pending") @db.MediumText // pending | approved | hidden
  verified      Boolean  @default(false) // matched a delivered order
  demoSessionId String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
  @@index([demoSessionId])
}

// Discount codes for a tenant's online store (platform plan coupons are `Coupon`).
model StoreCoupon {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String    @db.VarChar(40) // stored upper-case
  type             String    @default("percent") @db.MediumText // percent | flat | freeship
  value            Int       @default(0) // % or rupees
  minOrder         Int       @default(0)
  maxDiscount      Int       @default(0) // cap for percent; 0 = none
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int       @default(0) // 0 = unlimited
  perCustomerLimit Int       @default(0)
  used             Int       @default(0)
  firstOrderOnly   Boolean   @default(false)
  active           Boolean   @default(true)
  demoSessionId    String?
  createdAt        DateTime  @default(now())

  @@unique([tenantId, code])
  @@index([demoSessionId])
}

// Shopper accounts on a store (email OTP sign-in): saved addresses, wishlist, order history.
model StoreCustomer {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @db.VarChar(191)
  name           String    @default("") @db.MediumText
  phone          String    @default("") @db.MediumText
  addresses      String    @default("[]") @db.MediumText // JSON { name, phone, line1, line2, city, state, pincode, isDefault }[]
  wishlist       String    @default("[]") @db.MediumText // JSON productId[]
  marketingOptIn Boolean   @default(false)
  otpHash        String    @default("") @db.MediumText
  otpExpiresAt   DateTime?
  blocked        Boolean   @default(false)
  demoSessionId  String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([demoSessionId])
}

// Checkouts started but not completed; the owner can follow up on WhatsApp / email.
model AbandonedCart {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token          String    @db.VarChar(64) // browser cart id
  name           String    @default("") @db.MediumText
  phone          String    @default("") @db.MediumText
  email          String    @default("") @db.MediumText
  items          String    @default("[]") @db.MediumText
  subtotal       Int       @default(0)
  recovered      Boolean   @default(false)
  orderId        String?
  reminderSentAt DateTime?
  demoSessionId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, token])
  @@index([demoSessionId])
}
